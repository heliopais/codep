#!/usr/bin/env bash
# codep: CLI and launcher companion for macOS Spotlight project navigation.
# https://github.com/heliopais/codep

set -euo pipefail

# Resolve symlinks so Homebrew Cellar paths work correctly
REAL_BIN="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_BIN")" && pwd)"

# Discover resolver.py and launcher.applescript across different installation types
RESOLVER=""
LAUNCHER=""

CANDIDATE_RESOLVERS=(
    "$SCRIPT_DIR/../src/resolver.py"
    "$SCRIPT_DIR/../libexec/resolver.py"
    "$SCRIPT_DIR/../share/codep/resolver.py"
    "$HOME/Applications/codep.app/Contents/Resources/resolver.py"
    "/Applications/codep.app/Contents/Resources/resolver.py"
)

CANDIDATE_LAUNCHERS=(
    "$SCRIPT_DIR/../src/launcher.applescript"
    "$SCRIPT_DIR/../libexec/launcher.applescript"
    "$SCRIPT_DIR/../share/codep/launcher.applescript"
)

for r in "${CANDIDATE_RESOLVERS[@]}"; do
    if [ -f "$r" ]; then
        RESOLVER="$r"
        break
    fi
done

for l in "${CANDIDATE_LAUNCHERS[@]}"; do
    if [ -f "$l" ]; then
        LAUNCHER="$l"
        break
    fi
done

setup_app() {
    local dest_dir="${CODEP_DEST_DIR:-$HOME/Applications}"
    local app_name="${CODEP_APP_NAME:-codep}"
    local target_app="$dest_dir/$app_name.app"
    local editor_name="${CODEP_EDITOR:-Visual Studio Code}"

    echo "==> Setting up $app_name.app in $dest_dir..."

    if [ -z "$LAUNCHER" ] || [ ! -f "$LAUNCHER" ]; then
        echo "Error: launcher.applescript not found." >&2
        exit 1
    fi

    if [ -z "$RESOLVER" ] || [ ! -f "$RESOLVER" ]; then
        echo "Error: resolver.py not found." >&2
        exit 1
    fi

    mkdir -p "$dest_dir"
    echo "==> Compiling native launcher with Cocoa focus integration..."
    osacompile -o "$target_app" "$LAUNCHER"

    mkdir -p "$target_app/Contents/Resources"
    cp "$RESOLVER" "$target_app/Contents/Resources/resolver.py"
    chmod +x "$target_app/Contents/Resources/resolver.py"

    echo "==> Configuring icon..."
    local icon_found=false
    local possible_icons=(
        "/Applications/$editor_name.app/Contents/Resources/Code.icns"
        "/Applications/$editor_name.app/Contents/Resources/$editor_name.icns"
        "/Applications/Visual Studio Code.app/Contents/Resources/Code.icns"
        "/Applications/Cursor.app/Contents/Resources/Cursor.icns"
        "/Applications/Zed.app/Contents/Resources/Zed.icns"
    )

    for icns in "${possible_icons[@]}"; do
        if [ -f "$icns" ]; then
            cp "$icns" "$target_app/Contents/Resources/applet.icns"
            icon_found=true
            echo "    Using icon from: $icns"
            break
        fi
    done

    if [ "$icon_found" = false ]; then
        echo "    (No custom icon found; using default applet icon)"
    fi

    touch "$target_app"
    echo "==> Setup complete! Hit Cmd + Space, type '$app_name', and press Return."
}

show_help() {
    cat << 'EOF'
codep — Instant macOS Spotlight & CLI project opener

USAGE:
  codep                     Open the native Spotlight / GUI prompt
  codep <query>             Directly open a project matching <query>
  codep setup               Compile / update codep.app in ~/Applications
  codep -l, --list          List all discovered project directories
  codep -h, --help          Show this help message

EXAMPLES:
  codep mrt
  codep "benefits training"
  codep "exo inference"
  codep okrs

ENVIRONMENT:
  CODEP_EDITOR              Target editor (default: "Visual Studio Code")
  CODEP_SEARCH_ROOTS        Colon-separated search roots (e.g. "$HOME/repos:$HOME/Documents")
  CODEP_CONFIG              Path to custom config.json

CONFIGURATION:
  Optional JSON config at ~/.config/codep/config.json
EOF
}

if [ $# -eq 0 ]; then
    # Launch GUI app
    if [ -d "$HOME/Applications/codep.app" ]; then
        open -a "$HOME/Applications/codep.app"
    elif [ -d "/Applications/codep.app" ]; then
        open -a "/Applications/codep.app"
    else
        echo "codep.app not found. Running first-time setup..."
        setup_app
        open -a "$HOME/Applications/codep.app"
    fi
    exit 0
fi

case "$1" in
    setup)
        setup_app
        exit 0
        ;;
    -h|--help)
        show_help
        exit 0
        ;;
    -l|--list)
        if [ -z "$RESOLVER" ]; then
            echo "Error: resolver.py not found." >&2
            exit 1
        fi
        python3 -c "
import sys, os
sys.path.insert(0, os.path.dirname('$RESOLVER'))
from resolver import load_config, get_candidate_folders
cfg = load_config()
cands = get_candidate_folders(cfg['search_roots'], cfg['ignored_dirs'], cfg['max_depth'])
for c in sorted(cands):
    print(c)
"
        exit 0
        ;;
    *)
        if [ -z "$RESOLVER" ]; then
            echo "Error: resolver.py not found." >&2
            exit 1
        fi
        
        output=$(python3 "$RESOLVER" "$*")
        
        editor="Visual Studio Code"
        mode=""
        paths=()
        
        while IFS= read -r line; do
            if [[ "$line" =~ ^EDITOR:(.*) ]]; then
                editor="${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^MODE:(.*) ]]; then
                mode="${BASH_REMATCH[1]}"
            elif [ -n "$line" ]; then
                paths+=("$line")
            fi
        done <<< "$output"
        
        if [ "$mode" = "SINGLE" ]; then
            target="${paths[0]}"
            echo "Opening $target in $editor..."
            open -a "$editor" "$target"
        elif [ "$mode" = "MULTIPLE" ] || [ "$mode" = "APPROX" ]; then
            if [ "$mode" = "MULTIPLE" ]; then
                echo "Multiple matches found for '$*':"
            else
                echo "No exact match for '$*'. Approximate matches:"
            fi
            
            # Interactive numbered menu
            select opt in "${paths[@]}" "Cancel"; do
                if [ "$opt" = "Cancel" ] || [ -z "$opt" ]; then
                    echo "Cancelled."
                    exit 0
                fi
                # Expand leading ~/
                expanded="${opt/#\~/$HOME}"
                echo "Opening $expanded in $editor..."
                open -a "$editor" "$expanded"
                break
            done
        else
            echo "No matching or approximate projects found for '$*'." >&2
            exit 1
        fi
        ;;
esac
